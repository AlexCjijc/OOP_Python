function isPalindrome(str) {
    // удаление пробелов и нижний регистр
    const cleanedStr = str.replace(/\s+/g, '').toLowerCase();
    
    // проверка на палиндром
    const reversedStr = cleanedStr.split('').reverse().join('');
    return cleanedStr === reversedStr;
}

console.log(isPalindrome("А роза упала на лапу Азора")); // true
console.log(isPalindrome("доктор")); // false
console.log(isPalindrome("madam")); // true
console.log(isPalindrome("Able was I ere I saw Elba")); // true 
Python:
def is_palindrome(word):
    # приводим к нижнему регистру и убираем пробелы
    cleaned_word = ''.join(word.lower().split())
    # проверяем на палиндромом
    return cleaned_word == cleaned_word[::-1]

input_word = input("Ввод: ")
if is_palindrome(input_word):
    print(f'"{input_word}" палиндромом')
else:
    print(f'"{input_word}" не палиндромом')

